// AtomicOS stage 2. Stage 1 loads this image at 0x8200 and jumps to it
// in real mode. `copihue --flat 0x8200` (Makefile STAGE2_ORG). The kernel
// is read from LBA 9 (`dq 9` = 1 + STAGE2_SECTORS) to 0x10000.
// `dw 0; // KERNEL_SECTORS` is a marker, not the count that boots.
// The Makefile copies this file to build/stage2.lap and writes
// ceil(kernel.bin / 512) there. One INT 13h packet can address 128
// sectors from 0x1000:0 before the 16-bit offset wraps. make fails
// when the kernel needs more than that (or more than the floppy has
// left after KERNEL_LBA, if that bound is tighter).
//
// What the kernel still requires from this file (qemu-test checks it):
//   CR3 = 0x1000, PML4[0] = 0x2003, PDPT[0] = 0x3003, PD[0] = 0x83
//   E820 count word at 0x8000, entries of 24 bytes at 0x8004
//   GDT selectors 0x08/0x10 32-bit, 0x18/0x20 64-bit, stack 0x90000
//   a far jump to 0x10000 in long mode
// Do not add a `let` global here. --flat puts .bss before the address
// calculation of an empty image only when it is empty; a global would
// move _start off the first byte. Constants live in `data`.
//
// Pedido al lenguaje (Copihue v0.24.1, commit f2f9f386). Lo que v0.23.0
// rechazaba y esta versión ya compila no va en asm(): read_cr*/write_cr*,
// inb/outb, rdmsr/wrmsr, lgdt(&gdtr), cpuid/cpuid_edx, if carry, int_carry,
// while (1) { hlt(); }, y una llamada sin argumentos (ensambla como
// `call` de 16 bits; se comprobó con ndisasm). Sigue en asm() porque
// el compilador lo rechazó:
//   ds = 0, es = 0, ss = 0, fs = 0x10, gs = 0
//       assignment to undeclared variable 'ds' (y 'es', 'ss', 'fs', 'gs')
//   sp = 0x7C00, esp = 0, rsp = 0
//       assignment to undeclared variable 'sp' / 'esp' / 'rsp'
//   ah = 0x42, dl = 0, si = 0, di = 0, ax = 0, al = 1, eax = 1, ecx = 1
//       assignment to undeclared variable con ese nombre
//   let en naked
//       a naked function cannot have local variables
//   parámetro en naked
//       a naked function takes no parameters
//   jmp 0x10000
//       expected ';' after this, found '0x8200' (la misma sentencia jmp)
//   lodsb() / stosd() / pushfd() / clc()
//       unknown function 'lodsb' / 'stosd' / 'pushfd' / 'clc'
//   *(0x1000 as *u32) = 0x2003
//       expected ';' after this, found '='
// `dq page + 3` sí ensambla en un bloque data (tests/freestanding de
// v0.24.1). No sirve aquí: qemu-test lee las tablas en la dirección
// física 0x1000, y esta imagen vive en 0x8200.

data kern_packet {
    db 0x10, 0;
    dw 0; // KERNEL_SECTORS
    dw 0, 0x1000;
    dq 9;
}

data boot_msg {
    db "AtomicOS 0.8 64-bit", 13, 10, 0;
}

data disk_err_msg {
    db "Disk error!", 13, 10, 0;
}

data no_lm_msg {
    db "No64", 13, 10, 0;
}

data gdt {
    dq 0;
    dw 0xFFFF;
    dw 0;
    db 0;
    db 0x9A;
    db 0xCF;
    db 0;
    dw 0xFFFF;
    dw 0;
    db 0;
    db 0x92;
    db 0xCF;
    db 0;
    dw 0;
    dw 0;
    db 0;
    db 0x9A;
    db 0xAF;
    db 0;
    dw 0;
    dw 0;
    db 0;
    db 0x92;
    db 0;
    db 0;
}

data gdtr {
    dw 39;
    dd gdt;
}

bits 16 naked fn _start() {
    cli();
    asm("xor ax, ax"); // pedido: ax = 0 → assignment to undeclared variable 'ax'
    asm("mov ds, ax"); // pedido 0.24.2: ds = 0 → assignment to undeclared variable 'ds'
    asm("mov es, ax"); // pedido 0.24.2: es = 0 → assignment to undeclared variable 'es'
    asm("mov ss, ax"); // pedido 0.24.2: ss = 0 → assignment to undeclared variable 'ss'
    asm("mov sp, 0x7C00"); // pedido: sp = 0x7C00 → assignment to undeclared variable 'sp'
    asm("mov ax, 0x0003"); // pedido: ax = 0 → assignment to undeclared variable 'ax'
    int(0x10);
    asm("mov si, boot_msg"); // pedido: si = 0 → assignment to undeclared variable 'si'
    print_string();
    enable_a20();
    load_kernel();
    get_e820();
    check_long_mode();
    setup_page_tables();
    cli();
    lgdt(&gdtr);
    write_cr0(read_cr0() | 1);
    ljmp(0x08, protected_mode);
}

bits 16 naked fn print_string() {
    asm("push ax"); // pedido: push() → unknown function 'push'
    asm("push si"); // pedido: push() → unknown function 'push'; si = 0 → assignment to undeclared variable 'si'
    asm("cld"); // pedido: lodsb() → unknown function 'lodsb'
    asm(".loop:"); // pedido: a naked function cannot have local variables
    asm("lodsb"); // pedido: lodsb() → unknown function 'lodsb'
    asm("test al, al"); // pedido: al = 1 → assignment to undeclared variable 'al'
    asm("jz .done"); // pedido: jmp other → expected ';' after this, found 'other'
    asm("mov ah, 0x0E"); // pedido: ah = 0x42 → assignment to undeclared variable 'ah'
    int(0x10);
    asm("jmp .loop"); // pedido: jmp other → expected ';' after this, found 'other'
    asm(".done:"); // pedido: una naked no tiene etiquetas
    asm("pop si"); // pedido: pop() → unknown function 'pop'
    asm("pop ax"); // pedido: pop() → unknown function 'pop'
}

bits 16 naked fn enable_a20() {
    outb(0x92, inb(0x92) | 2);
}

bits 16 naked fn load_kernel() {
    asm("mov ah, 0x42"); // pedido: ah = 0x42 → assignment to undeclared variable 'ah'
    asm("mov si, kern_packet"); // pedido: si = 0 → assignment to undeclared variable 'si'
    asm("mov dl, [0x0500]"); // pedido: dl = 0 → assignment to undeclared variable 'dl'
    int(0x13);
    if (int_carry() != 0) {
        asm("jmp disk_error"); // pedido: jmp other → expected ';' after this, found 'other'
    }
}

bits 16 naked fn get_e820() {
    asm("xor ebx, ebx"); // pedido: rbx = 1 → assignment to undeclared variable 'rbx'
    asm("mov di, 0x8004"); // pedido: di = 0 → assignment to undeclared variable 'di'
    asm("mov word [0x8000], 0"); // pedido: *(0x1000 as *u32) = 0x2003 → expected ';' after this, found '='
    asm("push ds"); // pedido 0.24.2: ds = 0 → assignment to undeclared variable 'ds'
    asm("pop es"); // pedido: pop() → unknown function 'pop'; es = 0 → assignment to undeclared variable 'es'
    asm(".loop:"); // pedido: a naked function cannot have local variables
    asm("mov eax, 0xE820"); // pedido: eax = 1 → assignment to undeclared variable 'eax'
    asm("mov ecx, 24"); // pedido: ecx = 1 → assignment to undeclared variable 'ecx'
    asm("mov edx, 0x534D4150"); // pedido: edx = 1 → assignment to undeclared variable 'edx'
    asm("mov dword [di + 20], 1"); // pedido: store absoluto → expected ';' after this, found '='
    int(0x15);
    if carry {
        asm("jmp .done"); // pedido: jmp other → expected ';' after this, found 'other'
    }
    asm("cmp eax, 0x534D4150"); // pedido: eax = 1 → assignment to undeclared variable 'eax'
    asm("jne .done"); // pedido: jmp other → expected ';' after this, found 'other'
    asm("inc word [0x8000]"); // pedido: store absoluto → expected ';' after this, found '='
    asm("add di, 24"); // pedido: di = 0 → assignment to undeclared variable 'di'
    asm("cmp di, 0x8184"); // pedido: di = 0 → assignment to undeclared variable 'di'
    asm("jae .done"); // pedido: jmp other → expected ';' after this, found 'other'
    asm("test ebx, ebx"); // pedido: rbx = 1 → assignment to undeclared variable 'rbx'
    asm("jnz .loop"); // pedido: jmp other → expected ';' after this, found 'other'
    asm(".done:"); // pedido: una naked no tiene etiquetas
}

bits 16 naked fn check_long_mode() {
    // El bit ID de EFLAGS no tiene builtin. pushfd() → unknown function 'pushfd'.
    asm("pushfd"); // pedido: pushfd() → unknown function 'pushfd'
    asm("pop eax"); // pedido: pop() → unknown function 'pop'
    asm("mov ecx, eax"); // pedido: ecx = 1 → assignment to undeclared variable 'ecx'
    asm("xor eax, 0x200000"); // pedido: eax = 1 → assignment to undeclared variable 'eax'
    asm("push eax"); // pedido: push() → unknown function 'push'
    asm("popfd"); // pedido: pushfd() → unknown function 'pushfd'
    asm("pushfd"); // pedido: pushfd() → unknown function 'pushfd'
    asm("pop eax"); // pedido: pop() → unknown function 'pop'
    asm("push ecx"); // pedido: ecx = 1 → assignment to undeclared variable 'ecx'
    asm("popfd"); // pedido: pushfd() → unknown function 'pushfd'
    asm("cmp eax, ecx"); // pedido: eax = 1 → assignment to undeclared variable 'eax'
    asm("je no_long_mode"); // pedido: jmp other → expected ';' after this, found 'other'
    // `<` ensambla setl (con signo). 0x80000000 comparado así no es el jb
    // del manual. El AND previo descarta un leaf básico (bit 31 en claro);
    // en el rango 0x80000000..0xFFFFFFFF el orden con signo coincide con
    // el orden sin signo. cpuid(0x80000000) es idempotente.
    if ((cpuid(0x80000000) & 0x80000000) == 0) {
        asm("jmp no_long_mode"); // pedido: jmp other → expected ';' after this, found 'other'
    }
    if (cpuid(0x80000000) < 0x80000001) {
        asm("jmp no_long_mode"); // pedido: jmp other → expected ';' after this, found 'other'
    }
    if ((cpuid_edx(0x80000001) & (1 << 29)) == 0) {
        asm("jmp no_long_mode"); // pedido: jmp other → expected ';' after this, found 'other'
    }
}

bits 16 naked fn setup_page_tables() {
    write_cr3(0x1000);
    asm("mov edi, eax"); // pedido: di = 0 → assignment to undeclared variable 'di'. write_cr3 deja el valor en eax
    asm("xor eax, eax"); // pedido: eax = 1 → assignment to undeclared variable 'eax'
    asm("mov ecx, 4096"); // pedido: ecx = 1 → assignment to undeclared variable 'ecx'
    asm("cld"); // pedido: stosd() → unknown function 'stosd'
    asm("rep stosd"); // pedido: rep() → unknown function 'rep'; stosd() → unknown function 'stosd'
    asm("mov edi, 0x1000"); // pedido: di = 0 → assignment to undeclared variable 'di'
    asm("mov dword [edi], 0x2003"); // pedido: *(0x1000 as *u32) = 0x2003 → expected ';' after this, found '='
    asm("add edi, 0x1000"); // pedido: di = 0 → assignment to undeclared variable 'di'
    asm("mov dword [edi], 0x3003"); // pedido: store absoluto → expected ';' after this, found '='
    asm("add edi, 0x1000"); // pedido: di = 0 → assignment to undeclared variable 'di'
    asm("mov dword [edi], 0x83"); // pedido: store absoluto → expected ';' after this, found '='
}

bits 16 naked fn disk_error() {
    asm("mov si, disk_err_msg"); // pedido: si = 0 → assignment to undeclared variable 'si'
    print_string();
    while (1) { hlt(); }
}

bits 16 naked fn no_long_mode() {
    asm("mov si, no_lm_msg"); // pedido: si = 0 → assignment to undeclared variable 'si'
    print_string();
    while (1) { hlt(); }
}

bits 32 naked fn protected_mode() {
    asm("mov ax, 0x10"); // pedido: ax = 0 → assignment to undeclared variable 'ax'
    asm("mov ds, ax"); // pedido 0.24.2: ds = 0 → assignment to undeclared variable 'ds'
    asm("mov es, ax"); // pedido 0.24.2: es = 0 → assignment to undeclared variable 'es'
    asm("mov fs, ax"); // pedido 0.24.2: fs = 0x10 → assignment to undeclared variable 'fs'
    asm("mov gs, ax"); // pedido 0.24.2: gs = 0 → assignment to undeclared variable 'gs'
    asm("mov ss, ax"); // pedido 0.24.2: ss = 0 → assignment to undeclared variable 'ss'
    asm("mov esp, 0x90000"); // pedido: esp = 0 → assignment to undeclared variable 'esp'
    write_cr4(read_cr4() | 32);
    wrmsr(0xC0000080, rdmsr(0xC0000080) | 0x100);
    write_cr0(read_cr0() | 0x80000000);
    ljmp(0x18, long_mode);
}

bits 64 naked fn long_mode() {
    asm("mov ax, 0x20"); // pedido: ax = 0 → assignment to undeclared variable 'ax'
    asm("mov ds, ax"); // pedido 0.24.2: ds = 0 → assignment to undeclared variable 'ds'
    asm("mov es, ax"); // pedido 0.24.2: es = 0 → assignment to undeclared variable 'es'
    asm("mov fs, ax"); // pedido 0.24.2: fs = 0x10 → assignment to undeclared variable 'fs'
    asm("mov gs, ax"); // pedido 0.24.2: gs = 0 → assignment to undeclared variable 'gs'
    asm("mov ss, ax"); // pedido 0.24.2: ss = 0 → assignment to undeclared variable 'ss'
    asm("mov rsp, 0x90000"); // pedido: rsp = 0 → assignment to undeclared variable 'rsp'
    asm("jmp 0x10000"); // pedido: jmp 0x8200 → expected ';' after this, found '0x8200'
}
