// Ring 3. enter_user maps a code page at 0x400000 and a stack page at
// 0x401000, both with the user bit, then iretq. The program writes
// "user ok" through syscall/sysret and then reads 0x10000. That address
// sits in the supervisor 2MB page, so the read must raise #PF and the
// handler must not map it. resume_shell returns to the instruction
// after iretq.

let user_ran: i64 = 0;

syscall fn sys_user(nr: i64, ch: i64) -> i64 {
    if (nr == 1) {
        putc(ch);
        return 0;
    }
    if (nr == 2) {
        puts("user leak\n");
        return 0;
    }
    if (nr == 3) {
        putc('\n');
        puts("getpid ");
        put_int(proc_pid[cur_i]);
        puts("\n");
        return proc_pid[cur_i];
    }
    if (nr == 4) { return yield_current(); }
    if (nr == 5) { return exit_current(); }
    return 0;
}

fn program_syscall() -> i64 {
    set_syscall_stack(0x81000);
    let efer = rdmsr(0xC0000080);
    wrmsr(0xC0000080, efer | 1);
    wrmsr(0xC0000081, 0x0028001800000000);
    wrmsr(0xC0000082, &sys_user);
    wrmsr(0xC0000084, 0x200);
    return 0;
}

// Pedido para cada asm() de user_prog (Copihue v0.24.1). Es la imagen de
// anillo 3 copiada hasta user_prog_end.
//   syscall() → 'syscall' needs the hosted runtime (Linux syscalls) and is not available with --freestanding
//   rax = 1 / al = 1 → assignment to undeclared variable 'rax' / 'al'
//   a naked function cannot have local variables
naked fn user_prog() {
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 117"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 115"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 101"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 114"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 32"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 111"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 107"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 1"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rdi, 10"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov al, [0x10000]"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("mov rax, 2"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
    asm("syscall"); // pedido: syscall() de anfitrión, GPR no asignable, push()/pop(), o jmp other (bloque de user_prog)
}

naked fn user_prog_end() {
    hlt();
}

fn copy_user_page() -> i64 {
    let src: *u8 = &user_prog as *u8;
    let n = &user_prog_end - &user_prog;
    if (n <= 0 || n > 4096) { return 0; }
    zero_va(0x400000);
    let dst: *u8 = 0x400000;
    let i = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return n;
}

fn enter_user() -> i64 {
    if (user_ran != 0) {
        puts("user already\n");
        return 0;
    }
    let code = alloc_high_page();
    let stack = alloc_high_page();
    if (code == 0 || stack == 0) {
        puts("user fail alloc\n");
        return 0;
    }
    if (map_page(0x400000, code, 7) == 0 || map_page(0x401000, stack, 7) == 0) {
        puts("user fail map\n");
        return 0;
    }
    let n = copy_user_page();
    if (n == 0) {
        puts("user fail copy\n");
        return 0;
    }
    zero_va(0x401000);
    map_page(0x400000, code, 5);
    puts("user bytes=");
    put_int(n);
    puts("\n");
    let pml4: *u64 = 0x1000;
    pml4[0] = pml4[0] | 4;
    let pdpt: *u64 = 0x2000;
    pdpt[0] = pdpt[0] | 4;
    write_cr3(read_cr3());
    user_ran = 1;
    cli();
    asm("mov [resume_rsp], rsp"); // pedido: rsp = 0 → assignment to undeclared variable 'rsp'
    asm("mov [resume_rbp], rbp"); // pedido: rbp = → assignment to undeclared variable 'rbp'
    asm("lea rax, [.after_user]"); // pedido: jmp other → expected ';' after this, found 'other'
    asm("mov [resume_rip], rax"); // pedido: rax = 1 → assignment to undeclared variable 'rax'
    asm("push 0x33"); // pedido: push() → unknown function 'push'
    asm("push 0x402000"); // pedido: push() → unknown function 'push'
    asm("push 0x2"); // pedido: push() → unknown function 'push'
    asm("push 0x3B"); // pedido: push() → unknown function 'push'
    asm("push 0x400000"); // pedido: push() → unknown function 'push'
    iretq();
    asm(".after_user:"); // pedido: jmp other → expected ';' after this, found 'other'
    resume_rip = 0;
    sti();
    puts("user returned\n");
    return 0;
}
