// 4KB page tables on top of the bootloader's PML4 (0x1000), PDPT (0x2000)
// and PD (0x3000). PD[0] stays the supervisor 2MB identity page. A new
// directory slot gets a page table allocated from the identity-mapped
// pool (physical address below 2MB) so the kernel can write its entries.
//
// flags is the low 12 bits of the PTE: 3 is supervisor read/write,
// 7 is user read/write, 5 is user read-only. The user bit on a directory
// entry does not by itself make the page user-accessible; every level of
// the walk has to have it, and PML4/PDPT are left supervisor until
// enter_user.

fn map_page(va: i64, pa: i64, flags: i64) -> i64 {
    if (va < 0 || pa < 0) { return 0; }
    let pd: *u64 = 0x3000;
    let pd_idx = (va >> 21) & 511;
    let pt_idx = (va >> 12) & 511;
    let pde = pd[pd_idx];
    if ((pde & 1) == 0) {
        let table = alloc_low_page();
        if (table == 0) { return 0; }
        let z: *u8 = table;
        let i = 0;
        while (i < 4096) {
            z[i] = 0;
            i = i + 1;
        }
        pd[pd_idx] = table | 7;
        pde = pd[pd_idx];
    }
    if ((pde & 128) != 0) { return 0; }
    let pt: *u64 = (pde >> 12) << 12;
    pt[pt_idx] = ((pa >> 12) << 12) | flags;
    invlpg(va);
    return 1;
}

fn unmap_page(va: i64) -> i64 {
    if (va < 0) { return 0; }
    let pd: *u64 = 0x3000;
    let pd_idx = (va >> 21) & 511;
    let pt_idx = (va >> 12) & 511;
    let pde = pd[pd_idx];
    if ((pde & 1) == 0 || (pde & 128) != 0) { return 0; }
    let pt: *u64 = (pde >> 12) << 12;
    pt[pt_idx] = 0;
    invlpg(va);
    return 1;
}

fn zero_va(va: i64) -> i64 {
    let p: *u8 = va;
    let i = 0;
    while (i < 4096) {
        p[i] = 0;
        i = i + 1;
    }
    return 0;
}

// Not-present fault from ring 0: back the faulting page with a real frame
// and zero it. Pages at or above 2MB are preferred so the identity-mapped
// window stays available for page tables.
fn demand_map(va: i64) -> i64 {
    if (va < 0 || va >= 0x8000000) { return 0; }
    let page = (va >> 12) << 12;
    let pa = alloc_high_page();
    if (pa == 0) { pa = alloc_page(); }
    if (pa == 0) { return 0; }
    if (map_page(page, pa, 3) == 0) {
        free_page(pa);
        return 0;
    }
    zero_va(page);
    return 1;
}
