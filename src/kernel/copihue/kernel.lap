// LapageriaOS kernel entry. stage2.lap loads this flat image at 0x10000 and
// jumps to its first byte in 64-bit long mode (stack at 0x90000).
// Built with `copihue --flat 0x10000`, which places _start first.
//
// The imports are the rest of the kernel, in the order `cat` used to
// concatenate. The path is relative to this file. One namespace, one
// assembly unit. _start below is still emitted first.

import "console.lap";
import "keyboard.lap";
import "pmm.lap";
import "paging.lap";
import "gdt.lap";
import "sched.lap";
import "usermode.lap";
import "idt.lap";
import "ata.lap";
import "blk.lap";
import "fs.lap";
import "exec_img.lap";
import "exec.lap";
import "net.lap";
import "shell.lap";

fn _start() -> i64 {
    // Zero .bss (globals declared without an initializer).
    let bss: *u8 = bss_start();
    let n: i64 = bss_end() - bss_start();
    let i: i64 = 0;
    while (i < n) {
        bss[i] = 0;
        i = i + 1;
    }
    kmain();
    while (1) {
        cli();
        hlt();
    }
    return 0;
}

fn kmain() -> i64 {
    serial_init();
    set_color(0x0F);
    con_clear();
    set_color(0x0B);
    puts("LapageriaOS 0.8 (x86-64)\n");
    set_color(0x07);
    puts("Kernel in Copihue: VGA/COM1, IDT, PIT 100 Hz, PS/2, sched.\n");
    puts("Type 'help' for commands.\n\n");
    pmm_init();
    idt_init();
    while (ticks < 100) { hlt(); }
    puts("timer: ticks=");
    put_int(ticks);
    puts("\n");
    let mark = ticks;
    while (ticks < mark + 100) { hlt(); }
    puts("timer: ticks=");
    put_int(ticks);
    puts("\n");
    shell_run();
    return 0;
}
