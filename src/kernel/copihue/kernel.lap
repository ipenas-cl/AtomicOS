// AtomicOS kernel entry. boot64.asm loads this flat image at 0x10000 and
// jumps to its first byte in 64-bit long mode (stack at 0x90000).
// Built with `copihue --flat 0x10000`, which places _start first.

fn _start() -> i64 {
    // Zero .bss (globals declared without an initializer).
    let bss: *u8 = bss_start();
    let n: i64 = bss_end() - bss_start();
    let i: i64 = 0;
    while (i < n) {
        bss[i] = 0;
        i = i + 1;
    }
    kmain();
    while (1) {
        cli();
        hlt();
    }
    return 0;
}

fn kmain() -> i64 {
    serial_init();
    set_color(0x0F);
    con_clear();
    set_color(0x0B);
    puts("AtomicOS 0.8 (x86-64)\n");
    set_color(0x07);
    puts("Kernel, console, PS/2 keyboard driver and shell are written in Copihue.\n");
    puts("Type 'help' for commands.\n\n");
    shell_run();
    return 0;
}
