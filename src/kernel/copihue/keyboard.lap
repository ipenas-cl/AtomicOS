// LapageriaOS PS/2 keyboard (scancode set 1, US layout).
// IRQ1 (vector 33) reads port 0x60. The shell never polls the controller.

let kbd_buf: [u8; 128];
let volatile kbd_head: i64 = 0;
let volatile kbd_tail: i64 = 0;
let volatile kbd_irqs: i64 = 0;
let kbd_shift: i64 = 0;
let kbd_ext: i64 = 0;

fn kbd_translate(sc: i64) -> i64 {
    let lower: *u8 = "1234567890-=";
    let upper: *u8 = "!@#$%^&*()_+";
    let q_lower: *u8 = "qwertyuiop[]";
    let q_upper: *u8 = "QWERTYUIOP{}";
    let a_lower: *u8 = "asdfghjkl;'`";
    let a_upper: *u8 = "ASDFGHJKL:\"~";
    let z_lower: *u8 = "\\zxcvbnm,./";
    let z_upper: *u8 = "|ZXCVBNM<>?";
    if (sc >= 0x02 && sc <= 0x0D) {
        if (kbd_shift) { return upper[sc - 0x02]; }
        return lower[sc - 0x02];
    }
    if (sc >= 0x10 && sc <= 0x1B) {
        if (kbd_shift) { return q_upper[sc - 0x10]; }
        return q_lower[sc - 0x10];
    }
    if (sc >= 0x1E && sc <= 0x29) {
        if (kbd_shift) { return a_upper[sc - 0x1E]; }
        return a_lower[sc - 0x1E];
    }
    if (sc >= 0x2B && sc <= 0x35) {
        if (kbd_shift) { return z_upper[sc - 0x2B]; }
        return z_lower[sc - 0x2B];
    }
    if (sc == 0x39) { return ' '; }
    if (sc == 0x1C) { return '\n'; }
    if (sc == 0x0E) { return 8; }
    return 0;
}

fn kbd_push(c: i64) -> i64 {
    let next = (kbd_head + 1) & 127;
    if (next != kbd_tail) {
        kbd_buf[kbd_head] = c as u8;
        kbd_head = next;
    }
    return 0;
}

fn kbd_on_scancode(sc: i64) -> i64 {
    if (sc == 0xE0 || sc == 0xE1) { kbd_ext = 1; return 0; }
    if (kbd_ext != 0) { kbd_ext = 0; return 0; }
    if (sc == 0x2A || sc == 0x36) { kbd_shift = 1; return 0; }
    if (sc == 0xAA || sc == 0xB6) { kbd_shift = 0; return 0; }
    if ((sc & 0x80) != 0) { return 0; }
    let c = kbd_translate(sc);
    if (c != 0) { kbd_push(c); }
    return 0;
}

interrupt fn irq_kbd() {
    let sc = inb(0x60);
    kbd_irqs = kbd_irqs + 1;
    kbd_on_scancode(sc);
    outb(0x20, 0x20);
}

// Drop bytes left by the firmware, before IRQ1 is unmasked.
fn kbd_flush() -> i64 {
    let n = 0;
    while (n < 16 && (inb(0x64) & 1) != 0) {
        inb(0x60);
        n = n + 1;
    }
    return 0;
}

fn kbd_getc() -> i64 {
    while (kbd_head == kbd_tail) { hlt(); }
    let c = kbd_buf[kbd_tail];
    kbd_tail = (kbd_tail + 1) & 127;
    return c;
}
