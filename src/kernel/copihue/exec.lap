// exec: lee un AXE1 del disco (fs_read, con el CRC del bloque), arma un
// PML4 nuevo con el asignador que ya usa sched y lo deja corriendo en
// anillo 3. La cabecera está en docs/exec.md.
//
// El salto a anillo 3 es sched_go, que ya guarda el marco del shell.
// El programa vuelve con el syscall exit.

let exec_buf: [u8; 4096];
let exec_code: [u8; 4096];

fn exec_fail(r: i64) -> i64 {
    puts("exec fail ");
    put_int(r);
    putc('\n');
    return 0;
}

fn exec_is(s: *u8) -> i64 {
    let i = 0;
    while (s[i] != 0) {
        if (fs_name[i] != s[i]) { return 0; }
        i = i + 1;
    }
    return fs_name[i] == 0;
}

fn exec_magic() -> i64 {
    if (exec_buf[0] != 0x41) { return 0; }
    if (exec_buf[1] != 0x58) { return 0; }
    if (exec_buf[2] != 0x45) { return 0; }
    if (exec_buf[3] != 0x31) { return 0; }
    return 1;
}

// Escribe hola (válido), malo (magic en cero) y gordo (tamaño 65535).
// Los tres pasan por fs_write, así que el CRC del bloque queda bien;
// gordo y malo fallan recién en la cabecera.
fn exec_plant() -> i64 {
    let n = exec_fill(exec_buf);
    if (n < 16 || n > 4096) { return exec_fail(9); }
    let r = fs_write("hola", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    exec_buf[0] = 0;
    r = fs_write("malo", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    n = exec_fill(exec_buf);
    exec_buf[4] = 255;
    exec_buf[5] = 255;
    exec_buf[6] = 0;
    exec_buf[7] = 0;
    r = fs_write("gordo", exec_buf, n);
    if (r != 0) { return exec_fail(r); }
    puts("exec plant ok\n");
    return 0;
}

fn exec_run() -> i64 {
    let n = fs_read(fs_name, exec_buf, 4096);
    if (n < 0) {
        if (n == 0 - 5) {
            puts("exec corrupt\n");
            return 0;
        }
        return exec_fail(0 - n);
    }
    if (n < 16) {
        puts("exec bad size\n");
        return 0;
    }
    if (exec_magic() == 0) {
        puts("exec bad magic\n");
        return 0;
    }
    let sz = fs_u32(exec_buf, 4);
    let room = n - 16;
    if (sz <= 0 || sz > 4080 || sz > room) {
        puts("exec bad size\n");
        return 0;
    }
    let entry = fs_u32(exec_buf, 8);
    let ehi = fs_u32(exec_buf, 12);
    let end = 0x400000 + sz;
    if (ehi != 0 || entry < 0x400000 || entry >= 0x401000 || entry >= end) {
        puts("exec bad entry\n");
        return 0;
    }
    let i = 0;
    while (i < sz) {
        exec_code[i] = exec_buf[16 + i];
        i = i + 1;
    }
    cli();
    if (shared_init() == 0) {
        sti();
        return exec_fail(6);
    }
    if (build_proc(0, exec_code as i64, sz, 0) == 0) {
        write_cr3(0x1000);
        release_proc(0);
        sti();
        return exec_fail(6);
    }
    forge(0, entry, 0x402000, 0x202);
    sched_go();
    puts("exec ok\n");
    return 0;
}

fn cmd_exec() -> i64 {
    let pos = fs_scan(4, fs_name);
    if (pos < 0) { return exec_fail(11); }
    if (exec_is("plant")) { return exec_plant(); }
    return exec_run();
}
