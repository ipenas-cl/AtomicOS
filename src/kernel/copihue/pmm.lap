// Physical page allocator.
//
// The bootloader runs INT 15h AX=E820h before it leaves real mode and
// stores a word count at 0x8000 followed by up to 16 entries of 24 bytes
// at 0x8004 (base u64, length u64, type u32, ACPI attributes u32).
// Type 1 with the ACPI "valid" bit set is usable RAM.
//
// The bitmap covers the first 128MB (32768 pages). Pages below 1MB stay
// reserved: the kernel image, the bootloader page tables, the stacks and
// the VGA/BIOS hole live there. A free page below 2MB is also covered by
// the bootloader's 2MB identity map, so the kernel can use it as a page
// table. A free page at or above 2MB is only reachable after map_page.

let pmm_bitmap: [u8; 4096];
let pmm_free: i64 = 0;
let pmm_lo: i64 = 0;
let pmm_hi: i64 = 0;
// Si es > 0, la página se carga a esa zona. Llena la cuota: no se toma el marco.
let charge_zone: i64 = 0;

fn e820_base(i: i64) -> i64 {
    let p: *u64 = (0x8004 + i * 24) as *u64;
    return p[0];
}

fn e820_len(i: i64) -> i64 {
    let p: *u64 = (0x800C + i * 24) as *u64;
    return p[0];
}

fn e820_kind(i: i64) -> i64 {
    let p: *u32 = (0x8014 + i * 24) as *u32;
    return p[0];
}

fn e820_acpi(i: i64) -> i64 {
    let p: *u32 = (0x8018 + i * 24) as *u32;
    return p[0];
}

fn pmm_mask(page: i64) -> i64 {
    return 1 << (page & 7);
}

fn pmm_set_free(page: i64) -> i64 {
    if (page < 256 || page >= 32768) { return 0; }
    let bi = page >> 3;
    let mask = pmm_mask(page);
    let cur = pmm_bitmap[bi];
    if ((cur & mask) != 0) { return 0; }
    pmm_bitmap[bi] = cur | mask;
    pmm_free = pmm_free + 1;
    let pa = page << 12;
    if (pmm_lo == 0 || pa < pmm_lo) { pmm_lo = pa; }
    if (pa + 4096 > pmm_hi) { pmm_hi = pa + 4096; }
    return 1;
}

fn pmm_take(page: i64) -> i64 {
    if (page < 256 || page >= 32768) { return 0; }
    let bi = page >> 3;
    let mask = pmm_mask(page);
    let cur = pmm_bitmap[bi];
    if ((cur & mask) == 0) { return 0; }
    pmm_bitmap[bi] = cur & ~mask;
    pmm_free = pmm_free - 1;
    return 1;
}

fn pmm_mark_range(base: i64, len: i64) -> i64 {
    if (base < 0 || len <= 0) { return 0; }
    let end = base + len;
    if (end < base) { return 0; }
    let first = base >> 12;
    if ((base & 4095) != 0) { first = first + 1; }
    let last = end >> 12;
    if (first < 256) { first = 256; }
    if (last > 32768) { last = 32768; }
    while (first < last) {
        pmm_set_free(first);
        first = first + 1;
    }
    return 0;
}

// The image is loaded at 0x10000. .bss follows kernel.bin and is not in
// the file. Both have to end before 0x58000: process 0's kernel stack
// starts at 0x60000 and grows down through the 32 KiB under that top.
// Pages below 1MB stay reserved, so a .bss that stays under 1MB is not
// handed out. Overlapping that stack would still corrupt it. make
// rejects a kernel.bin past 512 sectors and an image+bss past 0x58000.
fn pmm_reserve_image() -> i64 {
    let a = 0x10000;
    let end = bss_end() as i64;
    let b = ((end + 4095) >> 12) << 12;
    while (a < b) {
        pmm_take(a >> 12);
        a = a + 4096;
    }
    return 0;
}

fn pmm_init() -> i64 {
    let nptr: *u16 = 0x8000;
    let n = nptr[0];
    if (n < 0 || n > 16) { n = 0; }
    puts("e820 n=");
    put_int(n);
    puts("\n");
    let i = 0;
    while (i < n) {
        let base = e820_base(i);
        let len = e820_len(i);
        let kind = e820_kind(i);
        let acpi = e820_acpi(i);
        puts("e820[");
        put_int(i);
        puts("] type=");
        put_int(kind);
        puts(" base=");
        put_hex64(base);
        puts(" len=");
        put_hex64(len);
        puts(" acpi=");
        put_int(acpi);
        puts("\n");
        if (kind == 1 && (acpi & 1) != 0) { pmm_mark_range(base, len); }
        i = i + 1;
    }
    if (pmm_free == 0) {
        puts("e820 fallback 0x00100000-0x00200000\n");
        pmm_mark_range(0x100000, 0x100000);
    }
    pmm_reserve_image();
    puts("pmm free=");
    put_int(pmm_free);
    puts(" base=");
    put_hex64(pmm_lo);
    puts(" end=");
    put_hex64(pmm_hi);
    puts("\n");
    return 0;
}

fn alloc_from(lo: i64, hi: i64) -> i64 {
    if (charge_zone > 0 && zone_room(charge_zone) == 0) { return 0; }
    let page = lo;
    while (page < hi) {
        if (pmm_take(page) != 0) {
            if (charge_zone > 0) { zone_account_alloc(charge_zone); }
            let pa = page << 12;
            if (tr_en[5] != 0) { trace_hit(5, proc_pid[cur_i], pa, 0); }
            return pa;
        }
        page = page + 1;
    }
    return 0;
}

fn alloc_page() -> i64 { return alloc_from(256, 32768); }
fn alloc_low_page() -> i64 { return alloc_from(256, 512); }
fn alloc_high_page() -> i64 { return alloc_from(512, 32768); }

fn free_page(pa: i64) -> i64 {
    if ((pa & 4095) != 0) { return 0; }
    let page = pa >> 12;
    if (page < 256 || page >= 32768) { return 0; }
    let bi = page >> 3;
    let mask = pmm_mask(page);
    let cur = pmm_bitmap[bi];
    if ((cur & mask) != 0) { return 0; }
    let r = pmm_set_free(page);
    if (r != 0 && charge_zone > 0) { zone_account_free(charge_zone); }
    if (r != 0 && tr_en[6] != 0) { trace_hit(6, proc_pid[cur_i], pa, 0); }
    return r;
}

fn page_is_free(pa: i64) -> i64 {
    if ((pa & 4095) != 0) { return 0; }
    let page = pa >> 12;
    if (page < 256 || page >= 32768) { return 0; }
    let bi = page >> 3;
    let mask = pmm_mask(page);
    if ((pmm_bitmap[bi] & mask) != 0) { return 1; }
    return 0;
}

fn pmm_test_high() -> i64 {
    let pa = alloc_high_page();
    if (pa == 0) { puts("pmm high fail alloc\n"); return 0; }
    if (pa < 0x200000) { puts("pmm high fail low\n"); return 0; }
    if (map_page(0x300000, pa, 3) == 0) { puts("pmm high fail map\n"); return 0; }
    let p: *u8 = 0x300000;
    p[0] = 0xAB;
    p[4095] = 0xCD;
    if (p[0] != 0xAB || p[4095] != 0xCD) { puts("pmm high fail write\n"); return 0; }
    if (unmap_page(0x300000) == 0) { puts("pmm high fail unmap\n"); return 0; }
    if (free_page(pa) == 0) { puts("pmm high fail free\n"); return 0; }
    puts("pmm high ok ");
    put_hex(pa);
    puts("\n");
    return 0;
}

fn pmm_test() -> i64 {
    let before = pmm_free;
    let a = alloc_page();
    let b = alloc_page();
    let c = alloc_page();
    if (a == 0 || b == 0 || c == 0) { puts("pmm fail alloc\n"); return 0; }
    if (a == b || a == c || b == c) { puts("pmm fail distinct\n"); return 0; }
    if (a >= 0x200000 || b >= 0x200000 || c >= 0x200000) { puts("pmm fail low\n"); return 0; }
    if (pmm_free != before - 3) { puts("pmm fail count\n"); return 0; }
    let pa: *u8 = a as *u8;
    let pb: *u8 = b as *u8;
    let pc: *u8 = c as *u8;
    pa[0] = 0x11;
    pb[0] = 0x22;
    pc[0] = 0x33;
    if (pa[0] != 0x11 || pb[0] != 0x22 || pc[0] != 0x33) { puts("pmm fail write\n"); return 0; }
    if (free_page(a) == 0 || free_page(b) == 0 || free_page(c) == 0) { puts("pmm fail free\n"); return 0; }
    if (pmm_free != before) { puts("pmm fail recount\n"); return 0; }
    if (free_page(a) != 0) { puts("pmm fail double\n"); return 0; }
    let d = alloc_page();
    if (d == 0) { puts("pmm fail reuse\n"); return 0; }
    let pd: *u8 = d as *u8;
    pd[0] = 0x44;
    if (pd[0] != 0x44) { puts("pmm fail rewrite\n"); return 0; }
    if (free_page(d) == 0 || pmm_free != before) { puts("pmm fail restore\n"); return 0; }
    puts("pmm ok\n");
    return pmm_test_high();
}
